@using Sandbox;
@using Sandbox.UI;
@using System
@using System.Globalization
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="bg-pattern" style="@BgStyle">
		<BgPattern />
	</div>

	<div class="center-menu">
		<div class="label-header" style="@HeaderStyle">BHOP</div>
		<div class="sidebar">
			<button class="button" onclick="@Resume">Resume</button>
			<button class="button" onclick="@ShowMenuSettings">Options</button>
			<button class="button" onclick="@Leave">@(Networking.IsActive ? "Leave lobby" : "Main menu")</button>
			<button class="button" onclick="@Quit">Quit</button>
		</div>
	</div>
</root>

@code
{
	protected override int BuildHash() => System.HashCode.Combine(Time.Now); /* Обновляется каждый тик */

	/// <summary>Темп музыки: один цикл вверх-вниз у заголовка за один удар.</summary>
	[Property, Range( 30, 240 )] public float Bpm { get; set; } = 100f;

	/// <summary>Амплитуда покачивания заголовка в пикселях.</summary>
	[Property, Range( 0, 40 )] public float HeaderAmplitude { get; set; } = 14f;

	/// <summary>Скорость бегущих надписей на фоне в пикселях в секунду (0 - стоят на месте, минус - в обратную сторону).</summary>
	[Property, Range( -200, 200 )] public float BgSpeed { get; set; } = 40f;

	// Фон: надписи двигаются вдоль линий (по диагонали вниз-вправо). Сдвиг зациклен на ширину одного слова,
	// поэтому движение бесконечное и без рывков.
	private string BgStyle
	{
		get
		{
			var period = BgPattern.WordWidth;
			var shift = ((Time.Now * BgSpeed) % period + period) % period;
			var x = (shift - period).ToString( "F1", CultureInfo.InvariantCulture );
			return $"transform: rotate(60deg) translateX({x}px);";
		}
	}

	private float HeaderOffset => MathF.Sin( Time.Now * MathF.PI * 2f * (Bpm / 60f) ) * HeaderAmplitude;

	private string HeaderStyle
	{
		get
		{
			var y = HeaderOffset.ToString( "F1", CultureInfo.InvariantCulture );
			return $"transform: translateY({y}px);";
		}
	}

	private void Resume()
	{
		Enabled = false;
	}

	private void ShowMenuSettings()
	{
		Game.Overlay.ShowSettingsModal();
	}

	private void Leave()
	{
		GameNetwork.LeaveToMenu();
	}

	private void Quit()
	{
		Game.Close();
	}
}
