@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if (ply.IsValid())
	{
		<div class="speedometer">🏃‍♂️  @GetSpeed() u/s</div>
		<div class="time">⌛  @ply.GetTime().ToString("F3")</div>
		<div class="time @GetSplitColor()">@GetSplitText()</div>
		@if (!string.IsNullOrEmpty(GetSegmentText()))
		{
			<div class="segment-name">@GetSegmentText()</div>
		}

		<div class="showFinal">@GetFinalText()</div>

		<div class="hints @(_sinceSpawn < HintsLifetime ? "" : "hidden")">
			<div class="hint">
				<div class="hint-key">@ControlHints.RestartKey</div>
				<div class="hint-text">@ControlHints.RestartText</div>
			</div>
			<div class="hint">
				<div class="hint-key">@ControlHints.CheckpointKey</div>
				<div class="hint-text">@ControlHints.CheckpointText</div>
			</div>
		</div>
	}
</root>

@code
{
	private const float HintsLifetime = 20f;

	private Player ply => Player.Local;
	private Player _spawnedPlayer;
	private RealTimeSince _sinceSpawn;

	protected override int BuildHash() => System.HashCode.Combine(Time.Now);

	/// <summary>
	/// Отсчёт подсказок идёт от спавна, а не от старта панели: иначе они истекут ещё на экране загрузки карты.
	/// </summary>
	protected override void OnUpdate()
	{
		if (ply == _spawnedPlayer) return;

		_spawnedPlayer = ply;
		_sinceSpawn = 0;
	}

	private int GetSpeed() => ply.sauceController.IsValid() ? ply.sauceController.Speed : 0;

	private static string FormatDelta(float? delta)
	{
		if (delta is null) return "";

		return $"({delta.Value.ToString("+0.000;-0.000;0.000")})";
	}

	/// <summary>
	/// Как в спидранах: голубой - первое прохождение (сохранения нет) или ровно то же время, зелёный - быстрее, красный - медленнее.
	/// </summary>
	private static string GetDeltaColor(float? delta)
	{
		if (delta is null) return "color-blue";

		var ms = System.MathF.Round(delta.Value * 1000f); // сравниваем с той точностью, что видна в HUD
		if (ms == 0f) return "color-blue";

		return (ms < 0f) ? "color-green" : "color-red";
	}

	private string GetSplitText()
	{
		if (!ply.CheckConfig()) return "Stopped (reset config)";

		if (ply.State == PlayerStateEnum.Finished)
			return $"{ply.GetTime().ToString("F3")} {FormatDelta(ply.FinalDelta)}";

		var seg = ply.segment;
		if (!seg.IsValid() || !seg.IsDone()) return "";

		return $"{seg.Split.ToString("F3")} {FormatDelta(seg.Delta)}";
	}

	private string GetSegmentText()
	{
		if (!ply.CheckConfig() || ply.State == PlayerStateEnum.Finished) return "";

		var seg = ply.segment;
		if (!seg.IsValid() || !seg.IsDone()) return "";

		return $"Segment {seg.Id}";
	}

	private string GetSplitColor()
	{
		if (!ply.CheckConfig()) return "color-red";

		if (ply.State == PlayerStateEnum.Finished)
			return GetDeltaColor(ply.FinalDelta);

		var seg = ply.segment;
		if (!seg.IsValid() || !seg.IsDone()) return "";

		return GetDeltaColor(seg.Delta);
	}

	private string GetFinalText()
	{
		if (ply.State != PlayerStateEnum.Finished) return "";

		return ply.IsNewRecord ? "Final · New record" : "Final";
	}
}
